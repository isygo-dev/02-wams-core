<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
    <route id="plan-log-publisher" autoStartup="true">
        <from uri="direct:plan-log-queue"/>
        <process ref="planLogKafkaProducerProcessor"/>
    </route>

    <route id="plan-log-consumer" autoStartup="true">
        <from uri="kafka:{{spring.kafka.topics.plan-logs}}?groupId={{spring.kafka.consumer.group-id}}-logs&amp;allowManualCommit=true&amp;consumersCount=1&amp;maxPollRecords=1&amp;breakOnFirstError=true&amp;autoOffsetReset=earliest"/>
        <process ref="planLogKafkaConsumerProcessor"/>
    </route>
</routes>
